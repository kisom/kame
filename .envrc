# Enter the flake's dev shell (the Rust toolchain, clippy, rustfmt, cargo-deny, make) on hosts with
# Nix and direnv. NixOS hosts get both from `programs.direnv.enable`, which turns on nix-direnv and
# caches the shell under .direnv/. Run `direnv allow` once in each clone. Hosts without Nix (titan)
# are left alone.
if has nix; then
  use flake
fi
